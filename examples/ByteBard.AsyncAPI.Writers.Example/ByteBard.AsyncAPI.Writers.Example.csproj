<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Examples reference floating/prerelease published packages, so opt out of central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CompleteKafkaSpec.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CompleteKafkaSpec.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ByteBard.AsyncAPI.Readers" Version="*-*" />
    <PackageReference Include="ByteBard.AsyncAPI.Writers" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ByteBard.AsyncAPI.Readers\ByteBard.AsyncAPI.Readers.csproj" />
  </ItemGroup>

</Project>
